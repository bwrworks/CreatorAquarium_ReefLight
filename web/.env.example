# =========================================================================
# Server-Side Environment Variables (Template)
# Copy this file to .env.local and define production secrets.
# Do NOT use NEXT_PUBLIC_ prefixes to prevent exposure in client JS bundles.
# =========================================================================

# Access Gate Passcode
APP_PASSCODE=reef_secret_passcode_here

# Cryptographic Session Cookie Secret (Used for HMAC-SHA256 signing)
SESSION_SECRET=change_me_to_a_random_32_character_string

# HiveMQ Cloud Broker Credentials (Server-Isolated)
HIVEMQ_WSS_URL=wss://your-broker-id.s1.eu.hivemq.cloud:8884/mqtt
HIVEMQ_USER=your_broker_username
HIVEMQ_PASS=your_broker_password
DEVICE_ID=reef-esp32-01

# OTA Authorization Token (Must match firmware/include/secrets.h OTA_SECRET_TOKEN)
OTA_SECRET_TOKEN=your_ota_secret_token_here
